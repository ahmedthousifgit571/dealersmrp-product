# Copy to .env and fill in. Never commit .env.

# Neon: pooled connection string (host contains "-pooler"), used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Neon: direct connection string (same, without "-pooler"), used by migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# First admin, created by `npm run db:seed`
SEED_ADMIN_NAME="Store Admin"
SEED_ADMIN_EMAIL="admin@yourshop.in"
SEED_ADMIN_PASSWORD=""

# Invoice AI. Leave GEMINI_API_KEY empty to use the built-in demo extractor.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Protects the daily invoice-image cleanup job (Vercel Cron sends it automatically). Any long random string.
CRON_SECRET=""
